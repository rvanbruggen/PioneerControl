server {
    listen 80;
    server_name _;

    # ---------- Static web app ----------
    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;

        # Cache-bust for development; static assets are tiny
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # ---------- Proxy: send commands to amplifier ----------
    location = /EventHandler.asp {
        # Handle CORS preflight
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin  * always;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
            add_header Access-Control-Allow-Headers "Content-Type, Pragma, Cache-Control, If-Modified-Since" always;
            add_header Access-Control-Max-Age       86400;
            add_header Content-Length                0;
            return 204;
        }

        proxy_pass         http://${AMP_IP}/EventHandler.asp;
        proxy_set_header   Host              ${AMP_IP};
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_http_version 1.1;

        # Timeouts — fail fast when amp is unreachable
        proxy_connect_timeout  5s;
        proxy_send_timeout     10s;
        proxy_read_timeout     10s;

        # CORS on actual responses
        add_header Access-Control-Allow-Origin * always;
    }

    # ---------- Proxy: poll amplifier status ----------
    location = /StatusHandler.asp {
        proxy_pass         http://${AMP_IP}/StatusHandler.asp;
        proxy_set_header   Host              ${AMP_IP};
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_http_version 1.1;

        # Timeouts — fail fast so the UI can show disconnected state quickly
        proxy_connect_timeout  3s;
        proxy_read_timeout     5s;

        # CORS on actual responses
        add_header Access-Control-Allow-Origin * always;
    }

    # ---------- Health check ----------
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
